{
  "type": "layout",
  "children": [
    {
      "type": "section",
      "props": {
        "divider_height": "120",
        "divider_layers_gap": "5",
        "divider_layers_opacity": "0.5",
        "divider_position": "top",
        "divider_responsive": true,
        "divider_shadow_blur_radius": "5",
        "divider_shadow_color": "#00000080",
        "divider_shadow_offset_x": "0",
        "divider_shadow_offset_y": "5",
        "divider_width": "100",
        "id": "meeting-lens",
        "image_position": "center-center",
        "padding_custom_bottom": "70",
        "padding_custom_top": "70",
        "style": "default",
        "style_custom_color": "#ccc",
        "title_breakpoint": "xl",
        "title_position": "top-left",
        "title_rotation": "left",
        "vertical_align": "middle",
        "width": "default"
      },
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "column",
              "props": {
                "image_position": "center-center",
                "position_sticky_breakpoint": "m"
              },
              "children": [
                {
                  "type": "headline",
                  "props": {
                    "content": "{MEETING_TITLE}",
                    "image_align": "left",
                    "image_margin": "xsmall",
                    "margin": "small",
                    "title_element": "h2"
                  }
                },
                {
                  "type": "text",
                  "props": {
                    "column_breakpoint": "m",
                    "content": "<p><strong>{BODY_NAME}</strong> {SUMMARY}</p>",
                    "margin": "small",
                    "margin_bottom": "default",
                    "margin_top": "default"
                  }
                },
                {
                  "type": "xs_meeting_lens",
                  "props": {
                    "accommodation_text": "{ACCOMMODATION_TEXT}",
                    "address": "{ADDRESS}",
                    "agenda_density": "comfortable",
                    "audio_url": "",
                    "body_name": "{BODY_NAME}",
                    "captions_url": "{CAPTIONS_URL}",
                    "card_style": "default",
                    "collapse_agenda": false,
                    "contact_link": "{CONTACT_LINK}",
                    "contact_name": "{CONTACT_NAME}",
                    "default_panel": "overview",
                    "duration": "{DURATION}",
                    "ends_at": "{ENDS_AT}",
                    "follow_playback": true,
                    "heading_level": "h2",
                    "iframe_allowed_origins": "",
                    "initial_agenda_key": "{INITIAL_AGENDA_KEY}",
                    "item_gap": "medium",
                    "layout": "workspace",
                    "live_url": "",
                    "location": "{LOCATION}",
                    "location_link": "#meeting-lens",
                    "media_mode": "{MEDIA_MODE}",
                    "media_position": "left",
                    "media_provider": "{MEDIA_PROVIDER}",
                    "media_width": "two-fifths",
                    "meeting_key": "{MEETING_KEY}",
                    "meeting_status": "{MEETING_STATUS}",
                    "meeting_type": "{MEETING_TYPE}",
                    "player_title": "{MEETING_TITLE} recording",
                    "poster": "{POSTER}",
                    "primary_recording_key": "recording-primary",
                    "privacy_message": "Load the recording to connect to the external media provider.",
                    "privacy_mode": false,
                    "public_notice": "{PUBLIC_NOTICE}",
                    "recording_url": "{RECORDING_URL}",
                    "remember_position": "none",
                    "resource_style": "list",
                    "scroll_active_item": false,
                    "show_filters": true,
                    "show_icons": true,
                    "show_search": true,
                    "starts_at": "{STARTS_AT}",
                    "status_mode": "manual",
                    "status_style": "badge",
                    "sticky_breakpoint": "medium",
                    "sticky_media": true,
                    "sticky_offset": 24,
                    "summary": "{SUMMARY}",
                    "sync_enabled": true,
                    "timezone_label": "{TIMEZONE_LABEL}",
                    "title": "{MEETING_TITLE}",
                    "transcript_language": "en",
                    "transcript_status": "{TRANSCRIPT_STATUS}",
                    "transcript_text": "{TRANSCRIPT_TEXT}",
                    "transcript_url": "{TRANSCRIPT_URL}",
                    "transition": "fade",
                    "transition_duration": 180,
                    "update_url": true,
                    "url_mode": "hash",
                    "url_parameter": "",
                    "youtube_nocookie": true
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "version": "5.0.43",
  "name": "Meeting Lens"
}
